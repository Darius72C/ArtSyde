# Copie ce fichier en .env et remplis les valeurs depuis la console Neon.

# Connexion "poolée" (l'hôte contient "-pooler") : utilisée par les apps Next.js.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/artsyde?sslmode=require"

# Connexion directe (sans "-pooler") : utilisée par Prisma pour les migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/artsyde?sslmode=require"

# Mot de passe de l'admin (/admin). Long et unique ; ne le mets jamais dans le dépôt.
# Le changer déconnecte toutes les sessions admin.
ADMIN_PASSWORD=""

# Photos des produits sur Cloudflare R2 (envoyées depuis /admin/produits).
# R2 > Overview : l'identifiant de compte (Account ID).
R2_ACCOUNT_ID=""
# R2 > Manage API tokens > Create API token, permission « Object Read & Write » limitée au bucket.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Le nom du bucket, ex. artsyde-photos.
R2_BUCKET=""
# L'adresse publique du bucket, sans / final : le domaine personnalisé (ex. https://photos.artsyde.ci)
# ou l'URL r2.dev (Settings > Public access).
R2_PUBLIC_URL=""

# Comptes clients (Better Auth) : connexion Google ou e-mail.
# Une longue valeur aléatoire, différente par environnement : openssl rand -base64 32
BETTER_AUTH_SECRET=""
# L'adresse du site, sans / final (http://localhost:3000 en local, https://artsyde.ci en ligne).
BETTER_AUTH_URL="http://localhost:3000"
# Google Cloud Console > API et services > Identifiants > ID client OAuth (application Web).
# URI de redirection autorisé : <BETTER_AUTH_URL>/api/auth/callback/google
# Sans ces deux clés, le bouton « Continuer avec Google » n'apparaît pas.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# E-mails aux clients (bienvenue, et bientôt commandes, mot de passe oublié) via Brevo.
# Brevo > SMTP & API > API keys > Generate a new API key.
BREVO_API_KEY=""
# Une adresse d'un domaine ou d'un expéditeur vérifié dans Brevo (Senders, domains & dedicated IPs).
EMAIL_FROM=""
# Facultatif : le nom affiché (par défaut « ArtSyde ») et l'adresse qui reçoit les réponses.
EMAIL_FROM_NAME="ArtSyde"
EMAIL_REPLY_TO=""

# Paiement en ligne (GeniusPay : Wave, Orange Money, MTN, Moov, carte). Sans les deux clés, le paiement en
# ligne est coupé et les commandes attendent un paiement confirmé à la main dans l'admin, comme avant.
# GeniusPay > Paramètres > API. Clés de test : pk_sandbox_… / sk_sandbox_….
GENIUSPAY_API_KEY=""
GENIUSPAY_API_SECRET=""
# Le secret des webhooks (whsec_…). Dans GeniusPay, l'adresse du webhook : <BETTER_AUTH_URL>/api/geniuspay/webhook
GENIUSPAY_WEBHOOK_SECRET=""
# true avec des clés de test : rien n'est réellement payé.
GENIUSPAY_SANDBOX="true"

# Référencement Google (SEO).
# L'adresse publique du site, sans / final (sert aux liens canoniques, au sitemap et au robots.txt).
# Vide : BETTER_AUTH_URL est utilisée.
SITE_URL="https://artsyde.ci"
# true seulement sur le site en ligne : sinon robots.txt et les pages demandent aux moteurs de ne rien indexer.
SITE_INDEXING="false"
# Google Search Console > Ajouter une propriété > Préfixe d'URL > Balise HTML : la valeur de content="…".
# Puis soumettre <SITE_URL>/sitemap.xml dans Search Console > Sitemaps.
GOOGLE_SITE_VERIFICATION=""
# Facultatif : Bing Webmaster Tools > Balise meta (msvalidate.01).
BING_SITE_VERIFICATION=""
